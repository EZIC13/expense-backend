FROM eclipse-temurin:21-jdk AS build
WORKDIR /workspace

# Maven wrapper + pom first, so dependencies are cached until pom.xml changes
COPY mvnw ./
COPY .mvn .mvn
COPY pom.xml .
RUN ./mvnw -B dependency:go-offline

COPY src ./src
RUN ./mvnw -B -e -DskipTests package

FROM eclipse-temurin:21-jre-jammy
WORKDIR /app

COPY --from=build /workspace/target/quarkus-app /app

EXPOSE 8080

CMD ["java", "-jar", "/app/quarkus-run.jar"]